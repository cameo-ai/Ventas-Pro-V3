# En Railway estas variables se cargan en el panel (pestaña Variables).
# Para probar en tu computador, copia este archivo como .env (NO lo subas a GitHub).

# Obligatorias
ADMIN_USER=tu_usuario
ADMIN_PASS=una_clave_larga_y_unica
NODE_ENV=production

# Solo si usas el envío de pedidos por correo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opcionales (la app ya se las arregla sola en Railway)
# DATA_DIR=/data
# SESSION_SECRET=
