# Archivo .env: va en la misma carpeta que server.js (NO lo subas a GitHub)

# Obligatorias para el primer arranque o para reemplazar la clave admin123
ADMIN_USER=tu_usuario
ADMIN_PASS=una_clave_larga_y_unica

# Si ya tienes un .env con DATA_DIR, SMTP_* u otras variables, déjalas como están

# Solo si usas el envío de pedidos por correo
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Solo si entras a la app por HTTPS (con certificado), activa esto:
# COOKIE_SECURE=true
# Solo si tienes un proxy delante de la app (Nginx, Cloudflare Tunnel...):
# TRUST_PROXY=1
